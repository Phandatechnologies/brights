# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=brights
DB_USER=brights_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Optional: where tutor verification documents are stored (never publicly served).
# Defaults to backend/private_media
# PRIVATE_MEDIA_ROOT=

# Email (development prints emails in the terminal; leave these unset)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Brights <no-reply@your-domain>
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Emailed immediately about child-safety reports (comma-separated). Empty = all superusers.
# REPORT_ALERT_EMAILS=safety@your-domain

# --- Production only (see docs/DEPLOYMENT.md) ---------------------------------
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DJANGO_ADMIN_URL=staff-change-me/
# TRUSTED_PROXY_COUNT=1
# PRIVATE_STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
